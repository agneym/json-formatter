amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"

steps {
  ["bun-fmt"] = new Step {
    glob = List("**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.css", "**/*.scss", "**/*.less", "**/*.html", "**/*.json", "**/*.json5", "**/*.jsonc", "**/*.yaml", "**/*.yml", "**/*.md", "**/*.markdown")
    check = "bun fmt --check {{files}}"
    fix = "bun fmt {{files}}"
  }
}
